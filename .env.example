# App
NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme_bin
# Si la contraseña tiene @ u otros símbolos, codifícala (@ -> %40)
DATABASE_URL=mysql://bin:changeme_bin@mysql:3306/bin_db

# Auth (mínimo 32 caracteres cada uno)
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
IOT_API_KEY=change-me-iot-api-key

# AI internal
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TOKEN=change-me-ai-internal-token

# Next.js
NEXT_PUBLIC_API_URL=http://localhost/api

# Maps (Fase 2)
OSRM_URL=http://osrm:5000
