generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Camion {
  idCamion            Int      @id @default(autoincrement()) @map("id_camion")
  idRegion            String?  @map("id_region") @db.VarChar(191)
  placa               String?  @db.VarChar(20)
  capacidad           String?  @db.VarChar(20)
  capacidadMax        Float?   @map("capacidad_max")
  capacidadDisponible Float?   @map("capacidad_disponible")
  estado              String?  @db.VarChar(20)
  latitud             Decimal? @db.Decimal(10, 6)
  longitud            Decimal? @db.Decimal(10, 6)
  tipoResiduos        String?  @map("tipo_residuos") @db.VarChar(255)
  rutas               Ruta[]
  region              Region?  @relation(fields: [idRegion], references: [idRegion], onDelete: SetNull)

  @@index([idRegion])
  @@map("Camiones")
}

model Region {
  idRegion    String   @id @default(cuid()) @map("id_region")
  nombre      String   @db.VarChar(100)
  metadata    Json?
  kpis        Json?
  simSettings Json?    @map("sim_settings")
  zones       Zone[]
  camiones    Camion[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("Regiones")
}

model Zone {
  idZone               String   @id @default(cuid()) @map("id_zone")
  idRegion             String?  @map("id_region")
  nombre               String   @db.VarChar(100)
  status               String   @default("active") @db.VarChar(20)
  geometry             Json
  centroidLng          Decimal? @map("centroid_lng") @db.Decimal(10, 6)
  centroidLat          Decimal? @map("centroid_lat") @db.Decimal(10, 6)
  areaSqM              Float?   @map("area_sq_m")
  wasteMetadata        Json?    @map("waste_metadata")
  assignedVehicleIds   Json?    @map("assigned_vehicle_ids")
  region               Region?  @relation(fields: [idRegion], references: [idRegion], onDelete: SetNull)
  contenedores         Contenedor[]
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([idRegion])
  @@map("Zonas")
}

model Contenedor {
  idContenedor              Int                    @id @default(autoincrement()) @map("id_contenedor")
  nombre                    String?                @db.VarChar(100)
  ubicacion                 String?                @db.VarChar(100)
  zona                      String?                @db.VarChar(50)
  idZone                    String?                @map("id_zone")
  zone                      Zone?                  @relation(fields: [idZone], references: [idZone], onDelete: SetNull)
  latitud                   Decimal?               @db.Decimal(10, 6)
  longitud                  Decimal?               @db.Decimal(10, 6)
  capacidad                 String?                @db.VarChar(20)
  capacidadMax              Float?                 @map("capacidad_max")
  estado                    String?                @db.VarChar(20)
  estadoOperativo           String?                @default("Activo") @map("estado_operativo") @db.VarChar(20)
  tipoResiduo               String?                @map("tipo_residuo") @db.VarChar(50)
  tiposResiduosPermitidos   String?                @map("tipos_residuos_permitidos") @db.VarChar(255)
  prioridadConfigurada      PrioridadIa?           @map("prioridad_configurada")
  sensores                  Sensor[]
  resultadoIa               ResultadoIa?
  rutaContenedores          RutaContenedor[]
  alertasContaminacion      AlertaContaminacion[]

  @@index([idZone])
  @@map("Contenedores")
}

model Sensor {
  idSensor      Int      @id @default(autoincrement()) @map("id_sensor")
  tipoSensor    String?  @map("tipo_sensor") @db.VarChar(50)
  idContenedor  Int?     @map("id_contenedor")
  contenedor    Contenedor? @relation(fields: [idContenedor], references: [idContenedor])
  lecturas      LecturaSensor[]

  @@index([idContenedor])
  @@map("Sensores")
}

model LecturaSensor {
  idLectura         Int       @id @default(autoincrement()) @map("id_lectura")
  idSensor          Int?      @map("id_sensor")
  fechaHora         DateTime? @map("fecha_hora")
  tempCelsius       Float?    @map("tempCelsius")
  humedad           Float?
  densidad          Float?
  distanciaBoteTapa Float?    @map("distanciaBoteTapa")
  pesoKg            Float?    @map("pesoKg")
  sensor            Sensor?   @relation(fields: [idSensor], references: [idSensor])

  @@index([idSensor, fechaHora], map: "idx_sensor_fecha")
  @@map("LecturasSensores")
}

enum PrioridadIa {
  alta
  media
  baja
}

model ResultadoIa {
  id                    Int          @id @default(autoincrement())
  idContenedor          Int          @map("id_contenedor")
  prioridad             PrioridadIa
  score                 Float?
  volumenPct            Float?       @map("volumen_pct")
  temperatura           Float?
  humedad               Float?
  densidad              Float?
  pesoKg                Float?       @map("peso_kg")
  tipoResiduoInferido   String?      @map("tipo_residuo_inferido") @db.VarChar(50)
  confianzaInferencia   Float?       @map("confianza_inferencia")
  contaminacionDetectada Boolean     @default(false) @map("contaminacion_detectada")
  mensajeContaminacion  String?      @map("mensaje_contaminacion") @db.VarChar(255)
  fechaClasificacion    DateTime     @default(now()) @map("fecha_clasificacion")
  contenedor            Contenedor   @relation(fields: [idContenedor], references: [idContenedor], onDelete: Cascade)

  @@unique([idContenedor], map: "uq_resultado_ia_contenedor")
  @@index([prioridad, fechaClasificacion(sort: Desc)], map: "idx_ria_prioridad")
  @@map("ResultadosIA")
}

model AlertaContaminacion {
  id               Int        @id @default(autoincrement())
  idContenedor     Int        @map("id_contenedor")
  tipoEsperado     String?    @map("tipo_esperado") @db.VarChar(50)
  tipoInferido     String?    @map("tipo_inferido") @db.VarChar(50)
  mensaje          String?    @db.VarChar(255)
  resuelta         Boolean    @default(false)
  fechaDeteccion   DateTime   @default(now()) @map("fecha_deteccion")
  contenedor       Contenedor @relation(fields: [idContenedor], references: [idContenedor], onDelete: Cascade)

  @@index([idContenedor, fechaDeteccion(sort: Desc)], map: "idx_alerta_contenedor")
  @@map("AlertasContaminacion")
}

model ReporteCiudadano {
  idReporte   Int       @id @default(autoincrement()) @map("id_reporte")
  descripcion String?   @db.Text
  foto        String?   @db.VarChar(255)
  latitud     Decimal?  @db.Decimal(10, 6)
  longitud    Decimal?  @db.Decimal(10, 6)
  fecha       DateTime?

  @@map("ReportesCiudadanos")
}

model Ruta {
  idRuta     Int      @id @default(autoincrement()) @map("id_ruta")
  nombreRuta String?  @map("nombre_ruta") @db.VarChar(100)
  fecha      DateTime? @db.Date
  idCamion   Int?     @map("id_camion")
  camion     Camion?  @relation(fields: [idCamion], references: [idCamion])
  contenedores RutaContenedor[]

  @@index([idCamion])
  @@map("Rutas")
}

model RutaContenedor {
  idRuta       Int @map("id_ruta")
  idContenedor Int @map("id_contenedor")
  orden        Int?
  ruta         Ruta @relation(fields: [idRuta], references: [idRuta])
  contenedor   Contenedor @relation(fields: [idContenedor], references: [idContenedor])

  @@id([idRuta, idContenedor])
  @@index([idContenedor])
  @@map("RutaContenedores")
}

model Usuario {
  idUsuario Int    @id @default(autoincrement()) @map("id_usuario")
  nombre    String @db.VarChar(100)
  email     String @unique @db.VarChar(100)
  password  String @db.VarChar(255)
  rol       String @db.VarChar(50)
  refreshTokens RefreshToken[]

  @@map("Usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [userId], references: [idUsuario], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
