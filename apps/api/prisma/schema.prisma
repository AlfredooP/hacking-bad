generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Camion {
  idCamion            Int      @id @default(autoincrement()) @map("id_camion")
  placa               String?  @db.VarChar(20)
  capacidad           String?  @db.VarChar(20)
  capacidadMax        Float?   @map("capacidad_max")
  capacidadDisponible Float?   @map("capacidad_disponible")
  estado              String?  @db.VarChar(20)
  latitud             Decimal? @db.Decimal(10, 6)
  longitud            Decimal? @db.Decimal(10, 6)
  tipoResiduos        String?  @map("tipo_residuos") @db.VarChar(255)
  rutas               Ruta[]

  @@map("Camiones")
}

model Contenedor {
  idContenedor     Int              @id @default(autoincrement()) @map("id_contenedor")
  ubicacion        String?          @db.VarChar(100)
  latitud          Decimal?         @db.Decimal(10, 6)
  longitud         Decimal?         @db.Decimal(10, 6)
  capacidad        String?          @db.VarChar(20)
  estado           String?          @db.VarChar(20)
  tipoResiduo      String?          @map("tipo_residuo") @db.VarChar(50)
  sensores         Sensor[]
  resultadoIa      ResultadoIa?
  rutaContenedores RutaContenedor[]

  @@map("Contenedores")
}

model Sensor {
  idSensor      Int      @id @default(autoincrement()) @map("id_sensor")
  tipoSensor    String?  @map("tipo_sensor") @db.VarChar(50)
  idContenedor  Int?     @map("id_contenedor")
  contenedor    Contenedor? @relation(fields: [idContenedor], references: [idContenedor])
  lecturas      LecturaSensor[]

  @@index([idContenedor])
  @@map("Sensores")
}

model LecturaSensor {
  idLectura         Int       @id @default(autoincrement()) @map("id_lectura")
  idSensor          Int?      @map("id_sensor")
  fechaHora         DateTime? @map("fecha_hora")
  tempCelsius       Float?    @map("tempCelsius")
  humedad           Float?
  distanciaBoteTapa Float?    @map("distanciaBoteTapa")
  pesoKg            Float?    @map("pesoKg")
  sensor            Sensor?   @relation(fields: [idSensor], references: [idSensor])

  @@index([idSensor, fechaHora], map: "idx_sensor_fecha")
  @@map("LecturasSensores")
}

enum PrioridadIa {
  alta
  media
  baja
}

model ResultadoIa {
  id                 Int          @id @default(autoincrement())
  idContenedor       Int          @map("id_contenedor")
  prioridad          PrioridadIa
  score              Float?
  volumenPct         Float?       @map("volumen_pct")
  temperatura        Float?
  humedad            Float?
  pesoKg             Float?       @map("peso_kg")
  fechaClasificacion DateTime     @default(now()) @map("fecha_clasificacion")
  contenedor         Contenedor   @relation(fields: [idContenedor], references: [idContenedor], onDelete: Cascade)

  @@unique([idContenedor], map: "uq_resultado_ia_contenedor")
  @@index([prioridad, fechaClasificacion(sort: Desc)], map: "idx_ria_prioridad")
  @@map("ResultadosIA")
}

model ReporteCiudadano {
  idReporte   Int       @id @default(autoincrement()) @map("id_reporte")
  descripcion String?   @db.Text
  foto        String?   @db.VarChar(255)
  latitud     Decimal?  @db.Decimal(10, 6)
  longitud    Decimal?  @db.Decimal(10, 6)
  fecha       DateTime?

  @@map("ReportesCiudadanos")
}

model Ruta {
  idRuta     Int      @id @default(autoincrement()) @map("id_ruta")
  nombreRuta String?  @map("nombre_ruta") @db.VarChar(100)
  fecha      DateTime? @db.Date
  idCamion   Int?     @map("id_camion")
  camion     Camion?  @relation(fields: [idCamion], references: [idCamion])
  contenedores RutaContenedor[]

  @@index([idCamion])
  @@map("Rutas")
}

model RutaContenedor {
  idRuta       Int @map("id_ruta")
  idContenedor Int @map("id_contenedor")
  orden        Int?
  ruta         Ruta @relation(fields: [idRuta], references: [idRuta])
  contenedor   Contenedor @relation(fields: [idContenedor], references: [idContenedor])

  @@id([idRuta, idContenedor])
  @@index([idContenedor])
  @@map("RutaContenedores")
}

model Usuario {
  idUsuario Int    @id @default(autoincrement()) @map("id_usuario")
  nombre    String @db.VarChar(100)
  email     String @unique @db.VarChar(100)
  password  String @db.VarChar(255)
  rol       String @db.VarChar(50)
  refreshTokens RefreshToken[]

  @@map("Usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [userId], references: [idUsuario], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
